# Copy to .env.local. Never commit credentials or put them in assets/js.
# Supabase: Connect > connection string. Use Direct connection, or Session
# pooler if your network cannot reach IPv6. Do not use Transaction pooler.
SUPABASE_DATABASE_URL=

# R2: account ID from Cloudflare dashboard; bucket name from R2 Object Storage.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=mulat-media
# Create an R2 S3 API token with Object Read & Write for this bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional migration-tool public media base. The app serves R2 at /api/media.
R2_PUBLIC_URL=

# Neon connection strings will be populated for the new Mulat Media project.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
